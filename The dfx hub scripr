local CurrentTheme = Themes["Green Theme"]
local ThemeObjects = {}

local function RegisterTheme(obj, prop, themeKey)
    table.insert(ThemeObjects, {Object = obj, Property = prop, Key = themeKey})
    obj[prop] = CurrentTheme[themeKey]
end

local function ApplyTheme(themeName)
    if not Themes[themeName] then return end
    CurrentTheme = Themes[themeName]
    for _, item in ipairs(ThemeObjects) do
        if item.Object and item.Object.Parent then
            TweenService:Create(item.Object, TweenInfo.new(0.25), {
                [item.Property] = CurrentTheme[item.Key]
            }):Play()
        end
    end
end

--// UI Helper Functions
local function AddCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function AddStroke(parent, color)
    local s = Instance.new("UIStroke")
    s.Thickness = 1.4
    s.Color = color or CurrentTheme.Border
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

