local function ToggleFly()
    flying = not flying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if flying then
        if humanoid then humanoid.PlatformStand = true end
        CreateAnalogStick()

        local bg = Instance.new("BodyGyro")
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = hrp.CFrame
        bg.Parent = hrp

        local bv = Instance.new("BodyVelocity")
        bv.velocity = Vector3.new(0, 0, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = hrp

        iyFlyConnection = RunService.RenderStepped:Connect(function()
            if not flying or not char or not hrp.Parent then
                if iyFlyConnection then iyFlyConnection:Disconnect() end
                return
            end

            local cam = Workspace.CurrentCamera
            local fVal, bVal, lVal, rVal = 0, 0, 0, 0
            if UserInputService.KeyboardEnabled then
                fVal = UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0
                bVal = UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0
                lVal = UserInputService:IsKeyDown(Enum.KeyCode.A) and -1 or 0
                rVal = UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0
                upVal = UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or upVal
                downVal = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or downVal
            else
                fVal = -stickVector.Y > 0.1 and -stickVector.Y or 0
                bVal = -stickVector.Y < -0.1 and -stickVector.Y or 0
                lVal = stickVector.X < -0.1 and stickVector.X or 0
                rVal = stickVector.X > 0.1 and stickVector.X or 0
            end

            local moveDirection = (cam.CFrame.LookVector * (fVal + bVal) + cam.CFrame.RightVector * (lVal + rVal) + Vector3.new(0, upVal - downVal, 0))
            bv.velocity = moveDirection * flySpeed
            bg.cframe = cam.CFrame
        end)
    else
        if iyFlyConnection then iyFlyConnection:Disconnect() end
        if flyGui then flyGui:Destroy() end
        if hrp:FindFirstChildOfClass("BodyVelocity") then hrp:FindFirstChildOfClass("BodyVelocity"):Destroy() end
        if hrp:FindFirstChildOfClass("BodyGyro") then hrp:FindFirstChildOfClass("BodyGyro"):Destroy() end
        if humanoid then humanoid.PlatformStand = false end
        stickVector = Vector2.new(0, 0)
        upVal, downVal = 0, 0
    end
end

