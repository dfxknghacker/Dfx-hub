    local base = Instance.new("Frame")
    base.Size = UDim2.new(0, 95, 0, 95)
    base.Position = UDim2.new(0.8, -45, 0.6, 0)
    base.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    base.BackgroundTransparency = 0.4
    base.BorderSizePixel = 0
    base.Parent = flyGui
    AddCorner(base, 48)
    AddStroke(base, Color3.fromRGB(56, 189, 248))

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 40, 0, 40)
    knob.Position = UDim2.new(0.5, -20, 0.5, -20)
    knob.BackgroundColor3 = Color3.fromRGB(56, 189, 248)
    knob.Text = ""
    knob.Parent = base
    AddCorner(knob, 20)

    local dragging = false
    local touchId = nil

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            touchId = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == touchId or input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local baseCenter = base.AbsolutePosition + (base.AbsoluteSize / 2)
            local currentPos = Vector2.new(input.Position.X, input.Position.Y)
            local delta = currentPos - baseCenter
            local radius = 35
            if delta.Magnitude > radius then
                delta = delta.Unit * radius
            end
            knob.Position = UDim2.new(0.5, delta.X - 20, 0.5, delta.Y - 20)
            stickVector = Vector2.new(delta.X / radius, delta.Y / radius)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == touchId or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            touchId = nil
            knob.Position = UDim2.new(0.5, -20, 0.5, -20)
            stickVector = Vector2.new(0, 0)
        end
